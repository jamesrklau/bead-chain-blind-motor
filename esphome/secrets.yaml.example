# Copy this file to "secrets.yaml" (same folder) and fill in your own values.
# secrets.yaml is listed in .gitignore, so it will not be uploaded to GitHub.
wifi_ssid: "YOUR_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"
api_key: "GENERATE_A_NEW_KEY"          # e.g. run: openssl rand -base64 32
ap_password: "CHOOSE_A_FALLBACK_HOTSPOT_PASSWORD"
